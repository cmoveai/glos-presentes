{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "E-commerce product catalog item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique product ID" },
        "name": { "type": "string", "description": "Product title" },
        "slug": { "type": "string", "description": "URL slug" },
        "price": { "type": "number", "description": "Regular price in BRL" },
        "promotionalPrice": { "type": "number", "description": "Sale price in BRL" },
        "category": { "type": "string", "description": "Category slug" },
        "categoryName": { "type": "string", "description": "Category display name" },
        "stock": { "type": "number", "description": "Stock count" },
        "images": { "type": "array", "items": { "type": "string" }, "description": "Image URLs" },
        "description": { "type": "string", "description": "Full description" },
        "shortDescription": { "type": "string", "description": "Short summary" },
        "featured": { "type": "boolean", "description": "Featured in hero or special showcases" },
        "bestseller": { "type": "boolean", "description": "Bestseller badge" },
        "isKit": { "type": "boolean", "description": "Whether it is a curated gift box" }
      },
      "required": ["id", "name", "slug", "price", "category", "images"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Order number / ID" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "status": { "type": "string", "description": "Current order status" },
        "total": { "type": "number", "description": "Total amount" },
        "subtotal": { "type": "number", "description": "Subtotal" },
        "shippingPrice": { "type": "number", "description": "Shipping cost" },
        "discount": { "type": "number", "description": "Applied discount" },
        "paymentMethod": { "type": "string", "description": "pix, credit_card, boleto" },
        "items": { "type": "array", "description": "List of ordered items" },
        "shippingAddress": { "type": "object", "description": "Destination address" },
        "customer": { "type": "object", "description": "Buyer contact details" }
      },
      "required": ["id", "createdAt", "status", "total", "items", "customer", "shippingAddress"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Customer account details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "User UID" },
        "name": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "description": "Email address" },
        "phone": { "type": "string", "description": "Phone number" },
        "cpf": { "type": "string", "description": "CPF tax ID" },
        "addresses": { "type": "array", "description": "Saved shipping addresses" }
      },
      "required": ["id", "name", "email"]
    }
  }
}
